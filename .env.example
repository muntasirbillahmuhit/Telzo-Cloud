# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration & Encryption
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production-at-least-32-chars
SESSION_ENCRYPTION_KEY=change-this-to-a-32-byte-hex-key-for-local-data-encryption

# Telegram OIDC (OpenID Connect) Credentials
# Obtain via Telegram BotFather / Login Widget (https://core.telegram.org/bots/telegram-login)
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/telegram/callback

# Telegram Official TDLib API Credentials
# Obtain from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# TDLib & Telzo Storage Paths
# Path to libtdjson.so (leave empty to use prebuilt-tdlib automatic path)
TDLIB_LIBRARY_PATH=
TDLIB_DATA_DIR=./data/tdlib
TELZO_DATA_DIR=./data/telzo
