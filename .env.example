# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production

# Telegram Official TDLib / API Credentials
# Obtain these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: Path to custom TDLib binary or pre-built library if used
TDLIB_LIBRARY_PATH=
